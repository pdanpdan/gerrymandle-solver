{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "types": [
      "vite/client",
      "vue"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "pages",
    "web",
    "vite.config.ts",
    "env.d.ts",
    "solver",
    "scripts"
  ]
}
